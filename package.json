{
    "name": "@trh/db",
    "version": "1.1.3-rc1",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/RobMayer/trh-db.git"
    },
    "description": "Typed in-memory data structures with lens-based query pipelines — DocumentDB, TreeDB, GraphDB",
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "build": "tsdown",
        "clean": "rm -rf ./dist",
        "lint": "tsc --noEmit",
        "prepublishOnly": "tsc --noEmit && rm -rf ./dist && tsdown"
    },
    "files": [
        "./dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.cts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "keywords": [
        "database",
        "in-memory",
        "graph",
        "tree",
        "document",
        "query",
        "pipeline",
        "lens"
    ],
    "author": "",
    "license": "UNLICENSE",
    "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
    "devDependencies": {
        "tsdown": "^0.22.14",
        "typescript": "^7",
        "eslint": "^10.8",
        "typescript-eslint": "^8.65.0",
        "@types/node": "^24.13.3",
        "@vitest/coverage-v8": "4.1.10",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "@trh/symbols": "^2.2.0"
    }
}
